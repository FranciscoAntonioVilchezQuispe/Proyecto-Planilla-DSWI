@model IngresosTrabajadores

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="RegistroMensual">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input asp-for="IdIngresoTrabajador" type="hidden" />
                <input asp-for="IdTrabajador" type="hidden" />
            </div>
            <div class="form-group">
                <label asp-for="Remuneracion" class="control-label">Remuneración</label>
                <input asp-for="Remuneracion" type="number" min="0" class="form-control" />
                <span asp-validation-for="Remuneracion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Vale" class="control-label"></label>
                <input asp-for="Vale" type="number" min="0" class="form-control" />
                <span asp-validation-for="Vale" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BonifCargo" class="control-label">Bonificación</label>
                <input asp-for="BonifCargo" type="number" min="0" class="form-control" />
                <span asp-validation-for="BonifCargo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Mensual" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
