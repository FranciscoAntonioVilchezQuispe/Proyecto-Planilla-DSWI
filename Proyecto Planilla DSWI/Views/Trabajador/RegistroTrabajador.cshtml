@model Proyecto_Planilla_Entidades.Trabajadores

@{
    ViewData["Title"] = "RegistroEmpleado";
}

<h2>@ViewBag.h1</h2>

<div>
    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Listado</a>
</div>

<hr />

<div class="row">
    <form asp-action="RegistroTrabajador">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <input asp-for="IdTrabajador" type="hidden" />
        </div>
        <div class="row">
            <div class="col">
                <div class="container text-center">
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="IdTipoDocumento" class="control-label">Tipo Documento: </label>
                        </div>
                        <div class="col-3 text-start">
                            <select asp-for="IdTipoDocumento" asp-items="ViewBag.tipoDocumento"
                                class="form-select"></select>
                            <span asp-validation-for="IdTipoDocumento" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="Documento" class="control-label">Nro. Documento: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="Documento" class="form-control" />
                            <span asp-validation-for="Documento" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="Nombres" class="control-label">Nombres: </label>
                        </div>
                        <div class="col-8 text-start">
                            <input asp-for="Nombres" class="form-control" />
                            <span asp-validation-for="Nombres" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="ApellidoPaterno" class="control-label">Apellido Paterno: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="ApellidoPaterno" class="form-control" />
                            <span asp-validation-for="ApellidoPaterno" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="ApellidoMaterno" class="control-label">Apellido Materno: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="ApellidoMaterno" class="form-control" />
                            <span asp-validation-for="ApellidoMaterno" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="FecNacimiento" class="control-label">Fec. Nacimiento: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="FecNacimiento" class="form-control" />
                            <span asp-validation-for="FecNacimiento" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="IdGenero" class="control-label">Genero: </label>
                        </div>
                        <div class="col-3 text-start">
                            @Html.DropDownListFor(
                            model => model.IdGenero,
                                                        ViewBag.genero as SelectList,
                                                        "-- Seleccione --",
                                                        new { @class = "form-select" }
                                                        )
                            <span asp-validation-for="IdGenero" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="IdEstadoCivil" class="control-label">Est. Civil: </label>
                        </div>
                        <div class="col-3 text-start">
                            @Html.DropDownListFor(
                                                        model => model.IdEstadoCivil,
                                                        ViewBag.estCivil as SelectList,
                                                        "-- Seleccione --",
                                                        new { @class = "form-select" }
                                                        )
                            <span asp-validation-for="IdEstadoCivil" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="Hijos" class="control-label">Nro. Hijos: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="Hijos" class="form-control" />
                            <span asp-validation-for="Hijos" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="Direccion" class="control-label">Dirección: </label>
                        </div>
                        <div class="col-8 text-start">
                            <input asp-for="Direccion" class="form-control" />
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="Email" class="control-label">Email: </label>
                        </div>
                        <div class="col-8 text-start">
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="IdCargo" class="control-label">Cargo: </label>
                        </div>
                        <div class="col-3 text-start">
                            @Html.DropDownListFor(
                                                        model => model.IdCargo,
                                                        ViewBag.cargo as SelectList,
                                                        "-- Seleccione --",
                                                        new { @class = "form-select" }
                                                        )
                            <span asp-validation-for="IdCargo" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="FecIngreso" class="control-label">Fec Ingreso: </label>
                        </div>
                        <div class="col-3 text-start">
                            <input asp-for="FecIngreso" class="form-control" />
                            <span asp-validation-for="FecIngreso" class="text-danger"></span>
                        </div>
                    </div>
                    <br />
                    <div class="row align-items-start">
                        <div class="col-2 text-end">
                            <label asp-for="IdSistemaPension" class="control-label">Sist. Pensión: </label>
                        </div>
                        <div class="col-3 text-start">
                            @Html.DropDownListFor(
                                                        model => model.IdSistemaPension,
                                                        ViewBag.sistPension as SelectList,
                                                        "-- Seleccione --",
                                                        new { @class = "form-select" }
                                                        )
                            <span asp-validation-for="IdSistemaPension" class="text-danger"></span>
                        </div>
                        <div class="col-2 text-end">
                            <label asp-for="IdSituacion" class="control-label">Situación: </label>
                        </div>
                        <div class="col-3 text-start">
                            @Html.DropDownListFor(
                                                        model => model.IdSituacion,
                                                        ViewBag.situacion as SelectList,
                                                        "-- Seleccione --",
                                                        new { @class = "form-select" }
                                                        )
                            <span asp-validation-for="IdSituacion" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-3">

@*                 <div class="form-group">
                    <button type="button" class="btn btn-primary" id="btnIngreso">
                        Ingresos
                    </button>
                </div> *@
                <br />
                <br>
                <div class="form-group">
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmModal">Grabar</button>
                </div>
            </div>
        </div>

        <div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalLabel">@ViewBag.h1</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        ¿Seguro que quieres grabar este registro?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>

                        <input type="submit" value="Confirmar" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="modalIngreso" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <!-- modal-lg para más ancho -->
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="confirmModalLabel">Ingreso</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body" id="modalBody">
                        <!-- Aquí se cargará la vista parcial -->
                    </div>
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        <script>
        document.addEventListener("DOMContentLoaded", function () {
            var idTrabajador = parseInt(document.getElementById("IdTrabajador").value || "0");

            if (idTrabajador === 0) {
                document.getElementById("btnIngreso").style.display = "none";
            } else {
                document.getElementById("btnIngreso").style.display = "block";
            }
        });
    </script>

    <script>
        document.getElementById("btnIngreso").addEventListener("click", function () {
                var id = document.getElementById("IdTrabajador").value;

                    fetch(`/Trabajador/IngresoMensual?id=${id}`)
                            .then(response => response.text())
                            .then(html => {
                                document.getElementById("modalBody").innerHTML = html;
                                var modal = new bootstrap.Modal(document.getElementById('modalIngreso'));
                                modal.show();
                            });
                    });

    </script>

}
