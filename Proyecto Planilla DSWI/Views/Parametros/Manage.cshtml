@model Parametros

@{
    ViewData["Title"] = "Configuración de Parámetros del Sistema";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Manage">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (Model.IdParametro > 0)
            {
                <input type="hidden" asp-for="IdParametro" />

                <div class="form-group">
                    <label class="control-label">ID</label>
                    <input value="@Model.IdParametro" class="form-control" disabled />
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RemBasico" class="control-label">Remuneración Básica</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input asp-for="RemBasico" class="form-control" type="number" step="0.01" min="0" />
                        </div>
                        <span asp-validation-for="RemBasico" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PorcAsigancionFamiliar" class="control-label">% Asignación Familiar</label>
                        <div class="input-group">
                            <input asp-for="PorcAsigancionFamiliar" class="form-control" type="number" step="0.01" min="0" max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PorcAsigancionFamiliar" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PorcExtra1" class="control-label">% Extra 1</label>
                        <div class="input-group">
                            <input asp-for="PorcExtra1" class="form-control" type="number" step="0.01" min="0" max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PorcExtra1" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="PorcExtra2" class="control-label">% Extra 2</label>
                        <div class="input-group">
                            <input asp-for="PorcExtra2" class="form-control" type="number" step="0.01" min="0" max="100" />
                            <span class="input-group-text">%</span>
                        </div>
                        <span asp-validation-for="PorcExtra2" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @if (Model.IdParametro > 0)
            {
                <div class="row mt-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Fecha Creación</label>
                            <input value="@Model.FecCreacion?.ToString("dd/MM/yyyy")" class="form-control" disabled />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Última Modificación</label>
                            <input value="@(Model.FecUltimaModificacion?.ToString("dd/MM/yyyy") ?? "N/A")" class="form-control" disabled />
                        </div>
                    </div>
                </div>

                <div class="form-group mt-3">
                    <label class="control-label">Estado</label>
                    <input value="@(Convert.ToBoolean( Model.Activo) ? "Activo" : "Inactivo")" class="form-control" disabled />
                </div>
            }

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Guardar Parámetros</button>

                @if (Model.IdParametro > 0)
                {
                    <button type="submit" formaction="@Url.Action("CambiarEstado")" class="btn @(Convert.ToBoolean(Model.Activo) ? "btn-warning" : "btn-success") ml-2">
                        @(Convert.ToBoolean(Model.Activo) ? "Desactivar" : "Activar")
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}