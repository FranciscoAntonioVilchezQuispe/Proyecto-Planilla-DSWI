@model List<Proyecto_Planilla_DSWI.Models.PlanillaMensual>
@using Proyecto_Planilla_DSWI.Utils
@{
    ViewData["Title"] = "Planilla Mensual";
    var añoActual = DateTime.Now.Year;
    var mesActual = DateTime.Now.Month;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h3 class="card-title">@ViewData["Title"]</h3>
            <div>
                <a id="btnExportar" href="@Url.Action("DescargarExcel", new { año = ViewBag.AñoSeleccionado, mes = ViewBag.MesSeleccionado })" class="btn btn-secondary btn-sm">
                    <i class="bi bi-file-excel"></i> Exportar
                </a>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-8">
                <form asp-action="BuscarPlanilla" method="post" class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Año</label>
                        <select name="año" class="form-select" asp-items="@(new SelectList(GlobalVariables.AñoPeriodo(), "Id", "Nombre", ViewBag.AñoSeleccionado))"></select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Mes</label>
                        <select name="mes" class="form-select" asp-items="@(new SelectList(GlobalVariables.Mes(), "Id", "Nombre", ViewBag.MesSeleccionado))"></select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <button type="submit" form="frmCalcular" class="btn btn-success">
                            <i class="bi bi-calculator"></i> Calcular
                        </button>
                    </div>
                </form>

                <!-- Formulario cálculo -->
                <form id="frmCalcular" asp-action="CalcularPlanilla" method="post" style="display: none;">
                    <input type="hidden" name="año" value="@ViewBag.AñoSeleccionado" />
                    <input type="hidden" name="mes" value="@ViewBag.MesSeleccionado" />
                </form>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="table-dark">
                        <tr>
                            <th>Trabajador</th>
                            <th>Cargo</th>
                            <th>Días Trab.</th>
                            <th>Horas Extras</th>
                            <th>Total Ingresos</th>
                            <th>Total Descuentos</th>
                            <th>Neto a Pagar</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nombre @item.Apellido</td>
                                <td>@item.IdCargo</td>
                                <td>@item.nDiasTrab</td>
                                <td>@item.nHorasExtra1 / @item.nHorasExtra2</td>
                                <td>S/ @item.TotalIngreso?.ToString("N2")</td>
                                <td>S/ @item.TotalDescuento?.ToString("N2")</td>
                                <td>S/ @item.TotalNetoBoleta?.ToString("N2")</td>
                                <td>
                                    <a href="@Url.Action("GenerarBoleta", new { idTrabajador = item.IdTrabajador, año = ViewBag.AñoSeleccionado, mes = ViewBag.MesSeleccionado })"
                                       class="btn btn-sm btn-info" target="_blank">
                                        <i class="bi bi-eye"></i> Boleta
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <form asp-action="GrabarPlanilla" method="post" class="mt-3">
                <input type="hidden" name="año" value="@ViewBag.AñoSeleccionado" />
                <input type="hidden" name="mes" value="@ViewBag.MesSeleccionado" />
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <input type="hidden" name="datos[@i].Año" value="@item.Año" />
                    <input type="hidden" name="datos[@i].Mes" value="@item.Mes" />
                    <input type="hidden" name="datos[@i].IdTrabajador" value="@item.IdTrabajador" />
                    <input type="hidden" name="datos[@i].IdSituacion" value="@item.IdSituacion" />
                    <input type="hidden" name="datos[@i].IdCargo" value="@item.IdCargo" />
                    <input type="hidden" name="datos[@i].Apellido" value="@item.Apellido" />
                    <input type="hidden" name="datos[@i].Nombre" value="@item.Nombre" />
                    <input type="hidden" name="datos[@i].IdSistemaPension" value="@item.IdSistemaPension" />
                    <input type="hidden" name="datos[@i].IdEstadoCivil" value="@item.IdEstadoCivil" />
                    <input type="hidden" name="datos[@i].Hijos" value="@item.Hijos" />
                    <input type="hidden" name="datos[@i].FechaIngreso" value="@item.FechaIngreso?.ToString("yyyy-MM-dd")" />
                    <input type="hidden" name="datos[@i].SueldoBasico" value="@item.SueldoBasico" />
                    <input type="hidden" name="datos[@i].PorcHoraExtra1" value="@item.PorcHoraExtra1" />
                    <input type="hidden" name="datos[@i].PorcHoraExtra2" value="@item.PorcHoraExtra2" />
                    <input type="hidden" name="datos[@i].PorcDescansoTrab" value="@item.PorcDescansoTrab" />
                    <input type="hidden" name="datos[@i].PorcFeriadoTrab" value="@item.PorcFeriadoTrab" />
                    <input type="hidden" name="datos[@i].PorcAsigFamiliar" value="@item.PorcAsigFamiliar" />
                    <input type="hidden" name="datos[@i].nHorasNormal" value="@item.nHorasNormal" />
                    <input type="hidden" name="datos[@i].nHorasExtra1" value="@item.nHorasExtra1" />
                    <input type="hidden" name="datos[@i].nHorasExtra2" value="@item.nHorasExtra2" />
                    <input type="hidden" name="datos[@i].nDiasTrab" value="@item.nDiasTrab" />
                    <input type="hidden" name="datos[@i].nDiasDescansos" value="@item.nDiasDescansos" />
                    <input type="hidden" name="datos[@i].nFeriadosTrab" value="@item.nFeriadosTrab" />
                    <input type="hidden" name="datos[@i].nDescansosTrab" value="@item.nDescansosTrab" />
                    <input type="hidden" name="datos[@i].nDiasInasistencias" value="@item.nDiasInasistencias" />
                    <input type="hidden" name="datos[@i].HaberBasico" value="@item.HaberBasico" />
                    <input type="hidden" name="datos[@i].ValesEmpleado" value="@item.ValesEmpleado" />
                    <input type="hidden" name="datos[@i].vHorasExtra1" value="@item.vHorasExtra1" />
                    <input type="hidden" name="datos[@i].vHorasExtra2" value="@item.vHorasExtra2" />
                    <input type="hidden" name="datos[@i].vAsigFamiliar" value="@item.vAsigFamiliar" />
                    <input type="hidden" name="datos[@i].vDescansoTrab" value="@item.vDescansoTrab" />
                    <input type="hidden" name="datos[@i].vFeriadoTrab" value="@item.vFeriadoTrab" />
                    <input type="hidden" name="datos[@i].BonificacionCargo" value="@item.BonificacionCargo" />
                    <input type="hidden" name="datos[@i].BonificacionMovilidad" value="@item.BonificacionMovilidad" />
                    <input type="hidden" name="datos[@i].CanastaNavidad" value="@item.CanastaNavidad" />
                    <input type="hidden" name="datos[@i].Escolaridad" value="@item.Escolaridad" />
                    <input type="hidden" name="datos[@i].DiaTrabajador" value="@item.DiaTrabajador" />
                    <input type="hidden" name="datos[@i].TotalIngreso" value="@item.TotalIngreso" />
                    <input type="hidden" name="datos[@i].PorcAporte" value="@item.PorcAporte" />
                    <input type="hidden" name="datos[@i].Aporte" value="@item.Aporte" />
                    <input type="hidden" name="datos[@i].PorcComision" value="@item.PorcComision" />
                    <input type="hidden" name="datos[@i].Comision" value="@item.Comision" />
                    <input type="hidden" name="datos[@i].PorcPrima" value="@item.PorcPrima" />
                    <input type="hidden" name="datos[@i].Prima" value="@item.Prima" />
                    <input type="hidden" name="datos[@i].TotalDescuento" value="@item.TotalDescuento" />
                    <input type="hidden" name="datos[@i].TotalNetoBoleta" value="@item.TotalNetoBoleta" />
                    <input type="hidden" name="datos[@i].TotalNetoBoletaCad" value="@item.TotalNetoBoletaCad" />
                }
                <div class="text-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Guardar Planilla
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="alert alert-info">No hay datos de planilla para el período seleccionado</div>
        }
    </div>
</div>