@model List<TipoDocumentos>
@using Proyecto_Planilla_Utils

@{
    ViewData["Title"] = "Lista de Tipos de Documento";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int pageSize = ViewBag.PageSize;
    GlobalEnum._Estado estado = ViewBag.Estado;
}

<h1>@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Manage" class="btn btn-primary">Crear Nuevo Tipo de Documento</a>
</p>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Filtrar por estado</h3>
    </div>
    <div class="card-body">
        <div class="btn-group" role="group">
            <a asp-action="TipoDocumento" asp-route-estado="@GlobalEnum._Estado.Todos" asp-route-page="1" class="btn btn-outline-secondary @(estado == GlobalEnum._Estado.Todos ? "active" : "")">Todos</a>
            <a asp-action="TipoDocumento" asp-route-estado="@GlobalEnum._Estado.Activo" asp-route-page="1" class="btn btn-outline-success @(estado == GlobalEnum._Estado.Activo ? "active" : "")">Activos</a>
            <a asp-action="TipoDocumento" asp-route-estado="@GlobalEnum._Estado.Inactivo" asp-route-page="1" class="btn btn-outline-danger @(estado == GlobalEnum._Estado.Inactivo ? "active" : "")">Inactivos</a>
        </div>
    </div>
</div>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Fecha Creación</th>
            <th>Última Modificación</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdTipoDocumento</td>
                <td>@item.Nombre</td>
                <td>@item.FecCreacion?.ToString("dd/MM/yyyy")</td>
                <td>@(item.FecUltimaModificacion?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                <td>
                    @if (Convert.ToBoolean(item.Activo))
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Manage" asp-route-id="@item.IdTipoDocumento" class="btn btn-sm btn-primary">Editar</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="id" value="@item.IdTipoDocumento" />
                        <button type="submit" class="btn btn-sm @(Convert.ToBoolean(item.Activo) ? "btn-warning" : "btn-success")">
                            @(Convert.ToBoolean(item.Activo) ? "Desactivar" : "Activar")
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="TipoDocumento" asp-route-page="@(currentPage - 1)" asp-route-estado="@estado">Anterior</a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="TipoDocumento" asp-route-page="@i" asp-route-estado="@estado">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="TipoDocumento" asp-route-page="@(currentPage + 1)" asp-route-estado="@estado">Siguiente</a>
            </li>
        </ul>
    </nav>
}

<div class="text-muted">
    Mostrando @((currentPage - 1) * pageSize + 1) a @Math.Min(currentPage * pageSize, ViewBag.TotalItems) de @ViewBag.TotalItems registros
</div>
