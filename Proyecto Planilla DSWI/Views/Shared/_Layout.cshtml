<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto_Planilla_DSWI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto_Planilla_DSWI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">Sistema Planillas</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Mantenedor -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="mantenedorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Mantenedor
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="mantenedorDropdown">
                                <li><a class="dropdown-item" asp-controller="Cargos" asp-action="Cargos">Cargos</a></li>
                                <li><a class="dropdown-item" asp-controller="Generos" asp-action="Index">Géneros</a></li>
                                <li><a class="dropdown-item" asp-controller="EstadosCiviles" asp-action="Index">Estados Civiles</a></li>
                                <li><a class="dropdown-item" asp-controller="SistemaPensiones" asp-action="Index">Sistema de Pensiones</a></li>
                                <li><a class="dropdown-item" asp-controller="SituacionTrabajador" asp-action="Index">Situación de Trabajador</a></li>
                                <li><a class="dropdown-item" asp-controller="TiposDocumentos" asp-action="Index">Tipos de Documentos</a></li>
                                <li><a class="dropdown-item" asp-controller="Parametros" asp-action="Index">Parámetros</a></li>
                            </ul>
                        </li>

                        <!-- Trabajadores -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="trabajadoresDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Trabajadores
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="trabajadoresDropdown">
                                <li><a class="dropdown-item" asp-controller="Trabajadores" asp-action="FichaDatos">Ficha Datos</a></li>
                            </ul>
                        </li>

                        <!-- Planilla -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="planillaDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Planilla
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="planillaDropdown">
                                <li><a class="dropdown-item" asp-controller="Asistencia" asp-action="CargaAsistencia">Asistencia Trabajador</a></li>
                                <li><a class="dropdown-item" asp-controller="Planilla" asp-action="PlanillaMensual">Planilla Mensual</a></li>
                            </ul>
                        </li>

                        <!-- Reportes -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="reportesDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Reportes
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="reportesDropdown">
                                <li><a class="dropdown-item" asp-controller="Reportes" asp-action="Boleta">Reporte Boleta</a></li>
                            </ul>
                        </li>
                    </ul>

                    <!-- Aquí puedes agregar el partial de login si es necesario -->
                   @*  <partial name="_LoginPartial" /> *@
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Proyecto_Planilla_DSWI - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
